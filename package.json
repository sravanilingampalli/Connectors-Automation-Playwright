{
  "name": "connectors-automation",
  "version": "1.0.0",
  "description": "TypeScript Playwright test automation framework with HTML reporting",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts",
    "test:ci": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts",
    "test:chromium": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --project=chromium-end-user",
    "test:end-user": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --project=chromium-end-user",
    "test:app-manager": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --project=chromium-app-manager",
    "test:connectors": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --project=chromium-app-manager",
    "test:connectors:smoke": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --project=chromium-app-manager src/modules/es-connectors/tests/ui-tests/smoke",
    "test:connectors:smoke:headed": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --project=chromium-app-manager src/modules/es-connectors/tests/ui-tests/smoke --headed",
    "test:connectors:regression": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --project=chromium-app-manager src/modules/es-connectors/tests/regression",
    "test:connectors:confluence": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --project=chromium-app-manager src/modules/es-connectors/tests/ui-tests/confluence/es-connectors-confluence.spec.ts",
    "test:connectors:confluence:api-token": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --project=chromium-app-manager src/modules/es-connectors/tests/ui-tests/confluence/es-connectors-confluence-api-token.spec.ts",
    "test:connectors:confluence:all": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --project=chromium-app-manager src/modules/es-connectors/tests/ui-tests/confluence",
    "test:connectors:confluence:configuration-settings": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --project=chromium-app-manager src/modules/es-connectors/tests/ui-tests/confluence/es-connectors-confluence-configuration-settings.spec.ts",
    "test:connectors:confluence:mandatory-field-validation": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --project=chromium-app-manager src/modules/es-connectors/tests/ui-tests/confluence/es-connectors-confluence-mandatory-field-validation.spec.ts",
    "test:connectors:confluence:save-button-state": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --project=chromium-app-manager src/modules/es-connectors/tests/ui-tests/confluence/es-connectors-confluence-save-button-state.spec.ts",
    "test:connectors:confluence:full-sync": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --project=chromium-app-manager src/modules/es-connectors/tests/ui-tests/confluence/es-connectors-confluence-full-sync.spec.ts",
    "test:connectors:e2e": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --project=chromium-app-manager src/modules/es-connectors/tests/ui-tests",
    "test:firefox": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --project=firefox",
    "test:webkit": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --project=webkit",
    "test:headed": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --headed",
    "test:ui": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --ui",
    "test:debug": "playwright test --config=src/modules/es-connectors/playwright.es-connectors.config.ts --debug",
    "test:codegen": "playwright codegen",
    "test:report": "playwright show-report playwright-report",
    "report:clean": "node scripts/clean-report.js",
    "install:browsers": "playwright install chromium"
  },
  "keywords": [
    "playwright",
    "typescript",
    "e2e",
    "automation",
    "connectors"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3",
    "dotenv": "^17.4.2",
    "typescript": "^6.0.3"
  }
}
