# Environment: local | staging | production
ENV=local

# Simpplr Zeus Test Sen
LOCAL_BASE_URL=https://zeus-test-sen.test.simpplr.xyz

# App Manager
APP_MANAGER_USER_ID=f5d45f54-1f52-48d8-8b17-3efa0767e500
APP_MANAGER_EMAIL=developer@simpplr.com
APP_MANAGER_PASSWORD=

# End User
END_USER_EMAIL=sravani.lingampalli+standarduser@simpplr.com
END_USER_PASSWORD=

# Dropbox Connector (Enterprise Search) — set in .env or dropbox.connector.data.json locally
DROPBOX_CONNECTOR_NAME=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Box Connector (Enterprise Search) — set in .env or box.connector.data.json locally
BOX_CONNECTOR_NAME=
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_ENTERPRISE_ID=

# Kibana (optional - for ingestion user index verification)
KIBANA_URL=
KIBANA_USERNAME=
KIBANA_PASSWORD=

# Confluence Connector (Enterprise Search)
CONFLUENCE_CONNECTOR_NAME=
CONFLUENCE_CLOUD_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_URL_LABEL=
CONFLUENCE_TOKEN_EXPIRY_DAYS=90

# Staging environment
STAGING_BASE_URL=

# Production environment
PROD_BASE_URL=

# General
TIMEOUT=60000
DEBUG=false

# Playwright HTML report folder (used by npm scripts)
PLAYWRIGHT_REPORT_DIR=playwright-report

# Video: on | off | retain-on-failure | on-first-retry
RECORD_VIDEO=on
