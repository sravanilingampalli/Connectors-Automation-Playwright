{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@core/*": ["./src/core/*"],
      "@es-connectors/*": ["./src/modules/es-connectors/*"]
    }
  },
  "include": [
    "src/**/*",
    "global-setup/**/*",
    "global-teardown/**/*",
    "playwright.config.ts",
    "src/modules/es-connectors/playwright.es-connectors.config.ts"
  ],
  "exclude": ["node_modules", "dist", "playwright-report", "test-results"]
}
